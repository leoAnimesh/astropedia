  "files": [
    "tests/chat-timeline.test.ts",
    "tests/recommendation-rules.test.ts",
    "tests/conversation-normalize.test.ts",
    "tests/model-plan.test.ts",
    "tests/reply-cleanup.test.ts"
  ]
