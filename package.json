{
  "name": "astropedia",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit -p .",
    "licenses": "node scripts/generate-licenses.mjs",
    "clean-prebuild": "rm -rf android ios .expo && npx expo prebuild",
    "build-ios": "eas build --profile production --platform ios --auto-submit --clear-cache",
    "build-android": "eas build --profile production --platform android --clear-cache",
    "build-android-apk": "eas build --profile preview --platform android --clear-cache",
    "build:android": "cd android && ./gradlew bundleRelease",
    "build:android:apk": "cd android && ./gradlew assembleRelease",
    "build:ios:sim": "xcodebuild -workspace ios/Astropedia.xcworkspace -scheme Astropedia -configuration Release -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath ios/build CODE_SIGNING_ALLOWED=NO build",
    "eas:preview": "eas build --profile preview --platform all",
    "eas:production": "eas build --profile production --platform all"
  },
  "dependencies": {
    "@expo-google-fonts/geist": "^0.4.1",
    "@expo-google-fonts/geist-mono": "^0.4.1",
    "@expo-google-fonts/instrument-serif": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.13",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~57.0.27",
    "expo-asset": "~57.0.19",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.21",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.22",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.25",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "fuse.js": "^7.3.0",
    "i18next": "^26.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.15",
    "react-native": "0.86.3",
    "react-native-blob-util": "^0.24.0",
    "react-native-executorch": "0.10.4",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-mmkv": "^4.3.1",
    "react-native-nitro-modules": "^0.35.6",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "private": true,
  "resolutions": {
    "hermes-compiler": "0.17.0"
  }
}
